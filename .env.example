# ============================================================
# CodeMaster 环境变量配置示例
# ------------------------------------------------------------
# 使用方式：复制本文件为 .env，再填入你自己的真实值
#     cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库。
# ============================================================

# ------------------------------------------------------------
# GEMINI_API_KEY（可选）
# 用于开启云端助教问答、代码深度审计等高阶能力。
# 密钥申请地址：https://aistudio.google.com/apikey
# 留空时平台会自动降级为内置的本地智能引擎，
# 所有课程、练习、测验、代码运行功能均可正常使用。
# ------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------
# APP_URL（部署后填写）
# 应用对外的访问地址，用于生成自引用链接与回调地址。
# 本地开发保持默认值即可。
# ------------------------------------------------------------
APP_URL="http://localhost:3000"

# ------------------------------------------------------------
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY（可选）
# 账号体系与进度云同步。在 Supabase 控制台创建项目后，
# Project Settings → API 里复制这两个值填入。
# 留空时站点保持匿名模式，进度仅保存在浏览器本地。
# 注意：ANON_KEY 是设计给前端公开使用的；
# service_role 密钥绝不可填入前端或提交到仓库！
# ------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
